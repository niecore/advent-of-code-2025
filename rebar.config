{erl_opts, [debug_info]}.

{deps,[
    {linalg, ".*", {git, "https://github.com/sklassen/erlang-linalg-native.git"}}
]}.

{shell, [
    {apps, [aoc2025]}
]}.

{project_plugins, [rebar3_format]}.

{profiles, [
    {test, [
        {deps, [
            {proper, "1.4.0"}
        ]},
        {erl_opts, [debug_info, export_all, nowarn_export_all]}
    ]}
]}.
